// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"


}


// ==========================================
// ENUMS
// ==========================================

enum VisibilityStatus {
  PUBLIC
  PRIVATE
}

enum MemberRole {
  MEMBER
  EDITOR
  ADMIN
}

enum TaskStatus {
  PENDING
  DONE
}

// Added: High-level classification of what the notification is about
enum NotificationType {
  SYSTEM_ALERT
  NOTE_SHARED
  WORKSPACE_UPDATE
  CLASSROOM_UPLOAD
  TASK_ASSIGNED
  AI_READY
}

// ==========================================
// MODELS
// ==========================================

model User {
  id        String   @id
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1-to-Many Relations
  notes           Note[]            @relation("UserNotes")
  officeSpaces    OfficeWorkspace[] @relation("UserOfficeWorkspaces")
  classrooms      Classroom[]       @relation("UserClassrooms")
  files           File[]            @relation("UserFiles")
  assignedTasks   TaskAssessment[]  @relation("UserAssignedTasks")
  aiResponses     AiResponse[]      @relation("UserAiResponses")

  // Memberships
  workspaceMemberships WorkspaceMember[]

  // Added: Connects the user to their personal notification center feed
  notifications   Notification[]    @relation("UserNotifications")
}

// Added: Central Alert Engine
model Notification {
  id        String           @id @default(uuid())
  type      NotificationType @default(SYSTEM_ALERT)
  title     String           // e.g., "New Task Assigned"
  message   String           @db.Text // e.g., "Suborna assigned you 'Review Project Architecture'"
  isRead    Boolean          @default(false) // Tracking state for unread badges
  createdAt DateTime         @default(now())

  // The User who receives this specific alert
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // Optional Relations: Pinpoints exactly which item triggered the alert
  noteId            String?
  note              Note?            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  officeWorkspaceId String?
  officeWorkspace   OfficeWorkspace? @relation(fields: [officeWorkspaceId], references: [id], onDelete: Cascade)
  classroomId       String?
  classroom         Classroom?       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  fileId            String?
  file              File?            @relation(fields: [fileId], references: [id], onDelete: Cascade)
  taskId            String?
  task              TaskAssessment?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id        String     @id
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  noteId            String?
  note              Note?            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  officeWorkspaceId String?
  officeWorkspace   OfficeWorkspace? @relation(fields: [officeWorkspaceId], references: [id], onDelete: Cascade)
  classroomId       String?
  classroom         Classroom?       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  fileId            String?
  file              File?            @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
  @@unique([userId, officeWorkspaceId])
  @@unique([userId, classroomId])
  @@unique([userId, fileId])
}

model Note {
  id         String           @id @default(uuid())
  title      String
  content    String           @db.Text
  link       String?          @unique
  status     VisibilityStatus @default(PRIVATE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  authorId   String
  author     User             @relation("UserNotes", fields: [authorId], references: [id], onDelete: Cascade)

  members    WorkspaceMember[]
  
  // Added: Tracks all historical notifications generated by this note
  notifications Notification[] 
}

model OfficeWorkspace {
  id         String           @id @default(uuid())
  title      String
  link       String?          @unique
  status     VisibilityStatus @default(PRIVATE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  authorId   String
  author     User             @relation("UserOfficeWorkspaces", fields: [authorId], references: [id], onDelete: Cascade)

  members    WorkspaceMember[]
  tasks      TaskAssessment[]
  
  // Added: Tracks all notifications linked to this workspace
  notifications Notification[]
}

model Classroom {
  id         String           @id @default(uuid())
  title      String
  link       String?          @unique
  status     VisibilityStatus @default(PRIVATE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  authorId   String
  author     User             @relation("UserClassrooms", fields: [authorId], references: [id], onDelete: Cascade)

  members    WorkspaceMember[]
  files      File[]
  
  // Added: Tracks all notifications generated within this classroom
  notifications Notification[]
}

model File {
  id          String           @id @default(uuid())
  title       String
  link        String
  status      VisibilityStatus @default(PRIVATE)
  createdAt   DateTime         @default(now())

  ownerId     String
  owner       User             @relation("UserFiles", fields: [ownerId], references: [id], onDelete: Cascade)
  
  classroomId String?
  classroom   Classroom?       @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  members     WorkspaceMember[]
  
  // Added: Linked alerts when a file is viewed or shared
  notifications Notification[]
}

model AiResponse {
  id        String   @id @default(uuid())
  title     String
  prompt    String   @db.Text
  response  String   @db.Text
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation("UserAiResponses", fields: [userId], references: [id], onDelete: Cascade)
}

model TaskAssessment {
  id                String          @id @default(uuid())
  title             String
  content           String          @db.Text
  deadline          DateTime
  status            TaskStatus      @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  assessedById      String
  assessedBy        User            @relation("UserAssignedTasks", fields: [assessedById], references: [id], onDelete: Cascade)

  officeWorkspaceId String?
  officeWorkspace   OfficeWorkspace? @relation(fields: [officeWorkspaceId], references: [id], onDelete: Cascade)
  
  // Added: Notifications pointing directly to this task evaluation
  notifications     Notification[]
}
